<settings>
    <!--https://stackoverflow.com/questions/52357496/add-gitlab-private-repository-as-maven-dependency-->
    <servers>
        <server>
            <id>gitlab-maven</id>
            <configuration>
                <httpHeaders>
                    <property>
                        <name>Private-Token</name>
                        <value>${env.GITLAB_MAVEN_TOKEN}</value>
                    </property>
                </httpHeaders>
            </configuration>
        </server>
    </servers>

</settings>
